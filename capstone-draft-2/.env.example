//copy the db connection string in here and rename the file to .env

DATABASE_URL="example: postgres://something:something@something"
BETTER_AUTH_SECRET= #generate using 'openssl rand -base64 32' or if using powershell v5.1 or later'$b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)'
BETTER_AUTH_URL= #local host url when running the app, use http://localhost:3000/ , you can also use the url that shows up in the terminal when you 'npm run dev'
SEED_CONVENER_EMAIL="you@example.com"