generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ---------- Enums

enum Role {     //normal users like students don't need a role because they don't have any exclusive functionality in this iteration
  CONVENER
  MENTOR
  SPONSOR
}

enum Status {     //status of EOI submissions
  PENDING
  APPROVED
  REJECTED
}

// --------- Better Auth default user and session models: https://www.prisma.io/docs/guides/authentication/better-auth/nextjs#32-add-better-auth-models-to-your-schema

model User {
  id            String    @id   @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false) //user needs to be verify
  phone         String?
  image         String?
  role          Role?          //role will be applied by convener when the EOI is approved
  organisation  String? 
  experience    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt   
  sessions      Session[]      // this is a relation field which is a virtual so it won't show on the actual db schema. the [] means this is a one to many record and users can have multiple sessions running at once
  accounts      Account[]      // same goes for this record ^ user can have many different login methods, this is for future proofing at the moment email and password is the only method
  projects      Project[]      // one sponsor can have many project proposals
  showcasePosts ShowcasePost[]  //one convener can have many showcase posts 

  @@unique([email])  //every user mus have a unique email
  @@map("user") //will be called by this name, not the model name at the top
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) //links userID to User.id > makes sure when a user is deleted their sessions are deleted too


  @@unique([token])  //every token is unique
  @@map("session")
}

//the account model is for future proofing also, every user gets an account row per login method i.e. google, github, apple account etc. (which we haven't implemented)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

//for email verification, stores the token details to compare against the link the user clicks
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ----------- App models (EOI forms, Posts) 

model EOIForm { //this form is for sponsors and mentors, they can choose their required role when filling it out
  id           String   @id @default(cuid())
  role         Role                          
  name         String
  email        String
  phone        String?
  organisation String?             //optional as mentors don't really need to enter that information, for future iterations will make seperate forms
  experience   String
  status       Status   @default(PENDING)
  cvfile       String
  createdAt    DateTime @default(now())
}

model Project { //this form is for project proposals from sponsors
  id          String   @id @default(cuid())
  title       String
  description String
  scope       String
  skills      String
  status      Status   @default(PENDING)     // APPROVED = shown on /projects
  sponsorId   String
  sponsor     User     @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ShowcasePost {
  id        String   @id @default(cuid())
  title     String
  semcompleted   String
  yearcompleted  String
  sponsor   String
  mentor    String
  organisation  String?
  student1  String
  student2  String?
  student3  String?
  student4  String?
  description      String         //string explaining the project
  authorId  String        //doesn't need to be included in the post
  author    User     @relation(fields: [authorId], references: [id])
  showcaseImageURL String?
  createdAt DateTime @default(now())
}

model MentorPost {
  id        String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  experience   String
  imageURL     String  @default("/images/pfp_default.jpg")
}

model SponsorPost {
  id        String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  organisation String
  experience   String
  imageURL     String  @default("/images/pfp_default.jpg")
}