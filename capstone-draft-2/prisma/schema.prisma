generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Enums: 

enum Role {
  CONVENER
  MENTOR
  SPONSOR
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

// Better Auth user and session models

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) //need to be verified 
  image         String?
  role          Role          //role will be applied by convener when the EOI is approved
  createdAt     DateTime  @defualt(now())
  updatedAt     DateTime  @updatedAt   
  sessions      Session[]      //this is a relation 
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}






// App models (EOI forms, Posts) 

model SponsorEOIForm {
  FormId            String    @id @unique @default(cuid())
  DateCreated       DateTime? @default(now())
  FirstName         String
  LastName          String
  Email             String
  PhoneNo           String?
  ProfessionalTitle String
  ExperienceSummary String
  Approved          Boolean   @default(false)
}

// Mentor EOI schema for form

model MentorEOIForm {
  FormId            String    @id @unique @default(cuid())
  DateCreated       DateTime? @default(now())
  FirstName         String
  LastName          String
  Email             String
  PhoneNo           String?
  ProfessionalTitle String
  ExperienceSummary String
  Approved          Boolean   @default(false)
}

// Sponsor project proposal form

model ProjectProposalForm {
  FormId         String    @id @unique @default(cuid())
  UserName       String //we'll need to grab this field from the signed in user data, we'll make it the user email
  CreationDate   DateTime? @default(now())
  ProposalTitle  String
  Sponsor        String
  SponsorCompany String?
  Description    String
  Scope          String
  SkillsRequired String
  Approved          Boolean   @default(false)
}

// Convener available project post > takes sponsor proposal and fills some details

// Convener showcase post 

model ShowcasePost {
  ShowcasePostId  String  @id @unique @default(cuid())
  SemesterAndYear String
  Description     String
  SponsorName     String
  SponsorCompany  String?
  StudentName1    String?
  StudentName2    String?
  StudentName3    String?
  StudentName4    String?
}

//Project post

model ProjectPost {
  id              String   @id @unique @default(cuid())
  ProjectTitle    String
  Sponsor         String
  SponsorCompany  String?
  Description     String
  Scope           String
  SkillsRequired  String
  DataPosted      DateTime @default(now())
  SemesterOffered String
  YearOffered     String
}

