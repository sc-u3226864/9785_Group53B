# Postgres container (docker-compose.yml reads these three)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
# Must match the three values above
DATABASE_URL=postgresql://changeme:changeme@localhost:5432/appdb?schema=public

# Auth.js: generate with `npx auth secret` and paste here
AUTH_SECRET=changeme
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web app)
AUTH_GOOGLE_ID=changeme
AUTH_GOOGLE_SECRET=changeme

# Comma-separated Google emails that `npm run db:seed` makes conveners
SEED_CONVENER_EMAILS=you@example.com

# ───────── Production server only (docker-compose.prod.yml) ─────────
# Leave these commented out on your laptop. See docs/05-aws-ec2-docker-deployment.md.
# On the server, DATABASE_URL above is ignored: docker-compose.prod.yml builds it
# from POSTGRES_* with host `db`. Use a long random POSTGRES_PASSWORD with only
# letters and digits (e.g. `openssl rand -hex 24`) so it is safe inside a URL.
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.example
# Without a domain/Caddy: publish the app on port 80 of the server
# APP_BIND=0.0.0.0
# APP_PORT=80
# With a domain: used by the optional Caddy HTTPS proxy (--profile https)
# DOMAIN=your-domain.example
# COMPOSE_PROFILES=https